<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background_light">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/brand_placeholder"
        android:contentDescription="@string/nav_users"
        android:padding="18dp"
        android:src="@drawable/ic_nav_users" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/nav_users"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/obsidian_navy"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/user_view_placeholder"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/slate_muted" />
</LinearLayout>

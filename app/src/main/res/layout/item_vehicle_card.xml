<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVehicle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Vehicle Image Container with Overlays -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@color/surface_variant_light">

            <ImageView
                android:id="@+id/imgVehicleCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/vehicle_title"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_car_placeholder" />

            <!-- Photo Counter Badge (if multiple photos) -->
            <TextView
                android:id="@+id/txtPhotoCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_photo_counter"
                android:text="📷 3"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/txtStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_status_available"
                android:text="@string/vehicle_status_available"
                android:textColor="@color/emerald_on_container_light"
                android:textSize="11sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Card Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Title and Menu Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtVehicleTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Toyota Hilux 4x4"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnVehicleMenu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Opciones"
                    android:src="@drawable/ic_more_vert" />
            </LinearLayout>

            <!-- Specs Row (Plate, Year, Color) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtVehiclePlate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/badge_plate"
                    android:fontFamily="monospace"
                    android:text="P 892-104"
                    android:textColor="@color/obsidian_navy"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="•"
                    android:textColor="@color/slate_muted" />

                <TextView
                    android:id="@+id/txtVehicleYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="2023"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/slate_charcoal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="•"
                    android:textColor="@color/slate_muted" />

                <TextView
                    android:id="@+id/txtVehicleColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Gris Metálico"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/slate_muted" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/outline_light" />

            <!-- Price & Action Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tarifa por día"
                        android:textSize="11sp"
                        android:textColor="@color/slate_muted" />

                    <TextView
                        android:id="@+id/txtVehiclePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$65.00 / día"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/emerald_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewDetails"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Ver detalles"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    app:cornerRadius="10dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardVehicleStat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_light"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/outline_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Rank/Icon, Vehicle Title, Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtStatRank"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/badge_plate"
                android:gravity="center"
                android:text="#1"
                android:textColor="@color/obsidian_navy"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtStatVehicleTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toyota Hilux 4x4 (2023)"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtStatPlateAndRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Placa: P 892-104  •  $65.00/día"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/slate_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtStatFeasibilityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_feasibility_high"
                android:text="Alta Rentabilidad"
                android:textColor="@color/emerald_on_container_light"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/surface_variant_light" />

        <!-- 4 Metrics Row: Ingresos | Rentas | Días | Km -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingresos"
                    android:textColor="@color/slate_muted"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/txtStatRevenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$130.00"
                    android:textColor="@color/emerald_primary"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rentas"
                    android:textColor="@color/slate_muted"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/txtStatRentalsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 viajes"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Días Alquilado"
                    android:textColor="@color/slate_muted"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/txtStatDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 días"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kilometraje"
                    android:textColor="@color/slate_muted"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/txtStatKm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="350 km"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Relative Progress Bar -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressStatScore"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:progress="75"
            app:indicatorColor="@color/emerald_primary"
            app:trackColor="@color/surface_variant_light"
            app:trackCornerRadius="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtStatUtilization"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Utilización: 25.0% del período"
                android:textColor="@color/slate_muted"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver detalle ›"
                android:textColor="@color/emerald_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

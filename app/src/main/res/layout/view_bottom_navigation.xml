<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:background="@drawable/bottom_nav_background"
    android:elevation="12dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="@drawable/nav_item_selected" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_home" android:contentDescription="@string/nav_home" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_home" android:textSize="10sp" android:textColor="@color/emerald_dark" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_vehicles" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_vehicle" android:contentDescription="@string/nav_vehicles" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_vehicles" android:textSize="10sp" android:textColor="@color/slate_muted" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_reservations" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_reservation" android:contentDescription="@string/nav_reservations" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_reservations" android:textSize="10sp" android:textColor="@color/slate_muted" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_users" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_users" android:contentDescription="@string/nav_users" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_users" android:textSize="10sp" android:textColor="@color/slate_muted" />
    </LinearLayout>
    <LinearLayout android:id="@+id/nav_profile" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_nav_profile" android:contentDescription="@string/nav_profile" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/nav_profile" android:textSize="10sp" android:textColor="@color/slate_muted" />
    </LinearLayout>
</LinearLayout>

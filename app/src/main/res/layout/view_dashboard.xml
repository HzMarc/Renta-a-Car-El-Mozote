<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">
        <FrameLayout
            android:id="@+id/dashboardHeader"
            android:layout_width="match_parent"
            android:layout_height="174dp"
            android:background="@drawable/dashboard_header_background"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingTop="34dp"
            android:paddingEnd="20dp"
            android:paddingBottom="26dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bienvenido"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="@color/white" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/dashboardUserName"
                        android:text="Administrador"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/notificationButton"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:backgroundTint="@color/obsidian_navy"
                    android:contentDescription="Notificaciones"
                    app:icon="@drawable/ic_notification"
                    app:iconSize="20dp"
                    app:iconTint="@color/white"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.ElMozote.BottomNavigationIndicator" />
                <TextView
                    android:id="@+id/dashboardProfileButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/profile_avatar_background"
                    android:clickable="true"
                    android:contentDescription="Abrir perfil"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="AD"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-24dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/dashboardSearchButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">
                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:gravity="center"
                        android:text="⌕"
                        android:textColor="@color/obsidian_navy"
                        android:textSize="24sp" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="¿A dónde viajas?"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/slate_muted" />
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/brand_placeholder"
                        android:padding="11dp"
                        android:src="@drawable/ic_filter_list"
                        android:contentDescription="Filtros" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/vehicleTypeFilters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                app:chipSpacingHorizontal="5dp"
                app:singleLine="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/vehicleFilterAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:checked="true"
                    android:text="Todos" />
                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Económico" />
                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="SUV" />
                <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Premium" />
            </com.google.android.material.chip.ChipGroup>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/emerald_primary"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESERVA ACTIVA"
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="@color/obsidian_navy"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Toyota Corolla 2024"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/obsidian_navy"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Recogida"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/obsidian_navy" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vie 20 nov · 10:00"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Devolución"
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:textColor="@color/obsidian_navy" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dom 22 nov · 18:00"
                                android:textAppearance="?attr/textAppearanceLabelLarge"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reservationDetailsButton"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:text="Ver detalles"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/obsidian_navy"
                        app:cornerRadius="20dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Vehículos disponibles"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/dashboardSeeAllVehicles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="Ver todos"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="@color/emerald_dark"
                    android:textStyle="bold" />
            </LinearLayout>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/dashboardVehiclesCard"
                        android:layout_width="154dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/surface_light"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline_light"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="82dp"
                                android:background="@color/emerald_container_light">
                                <ImageView
                                    android:layout_width="58dp"
                                    android:layout_height="58dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_nav_vehicle"
                                    android:tint="@color/obsidian_navy"
                                    android:contentDescription="@string/nav_vehicles" />
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Toyota Corolla"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="@color/obsidian_navy"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Sedán · 5 asientos"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="@color/slate_muted" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="$45 / día"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="@color/obsidian_navy"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="154dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/surface_light"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/outline_light"
                        app:strokeWidth="1dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="82dp"
                                android:background="@color/emerald_container_light">
                                <ImageView
                                    android:layout_width="58dp"
                                    android:layout_height="58dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_nav_vehicle"
                                    android:tint="@color/obsidian_navy"
                                    android:contentDescription="@string/nav_vehicles" />
                            </FrameLayout>
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="12dp">
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Kia Sportage"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="@color/obsidian_navy"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="SUV · 5 asientos"
                                    android:textAppearance="?attr/textAppearanceBodySmall"
                                    android:textColor="@color/slate_muted" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="$65 / día"
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:textColor="@color/obsidian_navy"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>



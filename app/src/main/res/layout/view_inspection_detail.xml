<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_light"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnInspViewBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/txtInspViewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Detalle de Inspección"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/obsidian_navy"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card: Header Inspection Info -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtInspViewBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_status_rented"
                            android:text="INSPECCIÓN DE SALIDA"
                            android:textColor="#0369A1"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtInspViewDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="2026-11-20 09:30 AM"
                            android:textColor="@color/slate_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="@color/surface_variant_light" />

                    <!-- Kilometraje & Combustible -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Odómetro de kilometraje"
                                android:textColor="@color/slate_muted"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/txtInspViewMileage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45,200 km"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Odómetro de gasolina"
                                android:textColor="@color/slate_muted"
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/txtInspViewFuel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lleno (4/4)"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="@color/emerald_primary"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Estado Físico y Equipamiento -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Estado Físico y Accesorios"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/obsidian_navy"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado Exterior"
                        android:textColor="@color/slate_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/txtInspViewExterior"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Buen estado, pintura limpia"
                        android:textColor="@color/obsidian_navy"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/surface_variant_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado Interior"
                        android:textColor="@color/slate_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/txtInspViewInterior"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Limpio, tapicería completa"
                        android:textColor="@color/obsidian_navy"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/surface_variant_light" />

                    <!-- Llanta de repuesto & Herramientas -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtInspViewSpareTire"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✓ Llanta de repuesto: Sí"
                            android:textColor="@color/emerald_on_container_light"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtInspViewTools"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="✓ Kit de herramientas: Sí"
                            android:textColor="@color/emerald_on_container_light"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card: Daños y Observaciones -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Daños y Notas"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/obsidian_navy"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registro de Daños"
                        android:textColor="@color/slate_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/txtInspViewDamages"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sin daños observados."
                        android:textColor="@color/slate_charcoal" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/surface_variant_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Observaciones Generales"
                        android:textColor="@color/slate_muted"
                        android:textSize="11sp" />
                    <TextView
                        android:id="@+id/txtInspViewObs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inspección realizada en orden."
                        android:textColor="@color/slate_charcoal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Fotografías de la Inspección -->
            <TextView
                android:id="@+id/txtInspViewPhotosTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Fotografías de Respaldo"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/obsidian_navy"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerInspViewPhotos"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/txtInspViewNoPhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/badge_plate"
                android:padding="12dp"
                android:text="No se adjuntaron fotografías en esta inspección."
                android:textColor="@color/slate_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Button: Volver -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInspViewClose"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/emerald_primary"
                android:text="Volver al Detalle de la Renta"
                android:textAllCaps="false"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

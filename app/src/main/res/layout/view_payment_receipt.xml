<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_light"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnReceiptBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/payment_receipt_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/obsidian_navy"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Printable Voucher / Receipt Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_light"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/outline_light"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Receipt Branding Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/brand_placeholder"
                            android:contentDescription="@null"
                            android:padding="8dp"
                            android:src="@drawable/ic_brand_car" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/app_name"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="@color/obsidian_navy"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COMPROBANTE OFICIAL DE PAGO"
                            android:textColor="@color/emerald_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="14dp"
                        android:background="@color/outline_light" />

                    <!-- Receipt Number & Timestamp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtReceiptNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:text="REC-2026-0001"
                            android:textColor="@color/obsidian_navy"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtReceiptDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2026-11-18 11:30 AM"
                            android:textColor="@color/slate_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Amount Paid Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/badge_status_paid"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MONTO PAGADO"
                            android:textColor="@color/emerald_on_container_light"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtReceiptAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="$50.00"
                            android:textAppearance="?attr/textAppearanceHeadlineMedium"
                            android:textColor="@color/emerald_on_container_light"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtReceiptTypeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/badge_plate"
                            android:text="ABONO PARCIAL"
                            android:textColor="@color/obsidian_navy"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Transaction Details Table -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <!-- Item: Contrato -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Contrato de Renta"
                                android:textColor="@color/slate_muted"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/txtReceiptContract"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="CTR-0001"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="6dp"
                            android:background="@color/surface_variant_light" />

                        <!-- Item: Cliente -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Cliente"
                                android:textColor="@color/slate_muted"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/txtReceiptCustomer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Carlos Alberto Martínez"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="6dp"
                            android:background="@color/surface_variant_light" />

                        <!-- Item: Vehículo -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Vehículo"
                                android:textColor="@color/slate_muted"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/txtReceiptVehicle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hyundai Elantra (P 451-230)"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="6dp"
                            android:background="@color/surface_variant_light" />

                        <!-- Item: Método de Pago -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Método de Pago"
                                android:textColor="@color/slate_muted"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/txtReceiptMethod"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Efectivo"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="6dp"
                            android:background="@color/surface_variant_light" />

                        <!-- Item: Saldo Anterior -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Saldo Anterior"
                                android:textColor="@color/slate_muted"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/txtReceiptPrevBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$120.00"
                                android:textColor="@color/slate_charcoal" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="6dp"
                            android:background="@color/surface_variant_light" />

                        <!-- Item: Nuevo Saldo -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Nuevo Saldo Pendiente"
                                android:textColor="@color/slate_muted"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/txtReceiptNewBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$70.00"
                                android:textColor="@color/crimson_alert"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Observaciones / Referencia -->
                    <TextView
                        android:id="@+id/txtReceiptNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/badge_plate"
                        android:padding="8dp"
                        android:text="Notas: Pago en efectivo entregado en caja."
                        android:textColor="@color/slate_charcoal"
                        android:textSize="11sp" />

                    <!-- Watermark Confirmation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ TRANSACCIÓN VERIFICADA Y REGISTRADA EN EL SISTEMA"
                            android:textColor="@color/emerald_on_container_light"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions: Copiar comprobante & Volver -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReceiptCopy"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Copiar Resumen del Comprobante"
                android:textAllCaps="false"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_receipt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReceiptViewAccount"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:backgroundTint="@color/emerald_primary"
                android:text="Volver a la Cuenta de Cobro"
                android:textAllCaps="false"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>

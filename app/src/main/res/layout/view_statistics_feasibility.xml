<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:clipToPadding="false"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Matriz de Factibilidad Económica"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/obsidian_navy"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Identificación de activos líderes, subutilizados y oportunidades de optimización"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/slate_muted" />

        <!-- 4 Focus Cards Grid (2x2) -->
        <!-- Card 1: Mayores Ingresos -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeasTopRevenue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/emerald_primary"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_trending_up"
                        app:tint="@color/emerald_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="VEHÍCULO CON MAYORES INGRESOS"
                        android:textColor="@color/emerald_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtFeasTopRevenueValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$130.00"
                        android:textColor="@color/emerald_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtFeasTopRevenueVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Toyota Hilux 4x4 (P 892-104)"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFeasTopRevenueDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Líder en recaudación. Excelente retorno sobre inversión operativa."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/slate_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 2: Menor Rendimiento -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeasLowestRevenue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeColor="#FCA5A5"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_trending_down"
                        app:tint="#B91C1C" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="VEHÍCULO CON MENOR RENDIMIENTO"
                        android:textColor="#B91C1C"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtFeasLowestRevenueValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0.00"
                        android:textColor="#B91C1C"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtFeasLowestRevenueVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nissan Kicks (P 710-985)"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFeasLowestRevenueDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Bajo volumen de ingresos en el período. Requiere activación comercial o salida de taller."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/slate_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 3: Mayor Frecuencia de Alquiler -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeasHighestFreq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/sky_primary"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_speedometer"
                        app:tint="@color/sky_primary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="MAYOR FRECUENCIA DE ALQUILER"
                        android:textColor="@color/sky_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtFeasHighestFreqValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 contratos"
                        android:textColor="@color/sky_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtFeasHighestFreqVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Toyota Hilux 4x4 (P 892-104)"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFeasHighestFreqDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Vehículo con mayor demanda de usuarios y rotación continua."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/slate_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card 4: Menor Utilización -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeasLowestUtil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface_light"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/amber_brand"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_clipboard"
                        app:tint="@color/amber_brand" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="MENOR UTILIZACIÓN DE FLOTA"
                        android:textColor="@color/amber_brand"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtFeasLowestUtilValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0%"
                        android:textColor="@color/amber_brand"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtFeasLowestUtilVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Nissan Kicks (P 710-985)"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtFeasLowestUtilDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Unidad subutilizada o en mantenimiento. Oportunidad de optimización tarifaria."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/slate_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Executive Strategic Recommendations Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Diagnóstico Estratégico por Vehículo"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/obsidian_navy"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutFeasibilityRecommendationsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>

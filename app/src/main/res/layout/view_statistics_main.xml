<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- Filter Bar: Time Period Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStatsPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPeriodAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/stats_filter_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPeriodToday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_filter_today" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPeriodWeek"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_filter_week" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPeriodMonth"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_filter_month" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPeriodYear"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_filter_year" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Sub-Module View Navigation Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStatsViews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipViewDashboard"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/stats_tab_dashboard"
                app:chipIcon="@drawable/ic_analytics" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipViewVehicles"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_tab_vehicles"
                app:chipIcon="@drawable/ic_nav_vehicle" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipViewComparison"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_tab_comparison"
                app:chipIcon="@drawable/ic_trending_up" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipViewFeasibility"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stats_tab_feasibility"
                app:chipIcon="@drawable/ic_speedometer" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Content swap area -->
    <FrameLayout
        android:id="@+id/containerStatsContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>

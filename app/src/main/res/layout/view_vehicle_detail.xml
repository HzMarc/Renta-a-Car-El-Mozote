<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <!-- Detail Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/surface_light"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnDetailBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/vehicle_detail_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/obsidian_navy"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnDetailMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Opciones"
            android:src="@drawable/ic_more_vert" />
    </LinearLayout>

    <!-- Detail Scrollable Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Photo Viewer / Gallery -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_variant_light"
                android:paddingVertical="12dp">

                <!-- Multiple Photos Gallery -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerDetailGallery"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:visibility="gone" />

                <!-- Single Photo / Placeholder Fallback -->
                <FrameLayout
                    android:id="@+id/layoutDetailSinglePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginHorizontal="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:strokeColor="@color/outline_light"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/imgDetailSinglePhoto"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="Foto del vehículo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_car_placeholder" />
                    </com.google.android.material.card.MaterialCardView>
                </FrameLayout>
            </FrameLayout>

            <!-- Main Specs Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Title & Status Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtDetailTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Toyota Hilux 4x4"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="@color/obsidian_navy"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDetailStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_status_available"
                        android:text="@string/vehicle_status_available"
                        android:textColor="@color/emerald_on_container_light"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Plate & Color Subtitle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtDetailPlate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/badge_plate"
                        android:fontFamily="monospace"
                        android:text="P 892-104"
                        android:textColor="@color/obsidian_navy"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="•"
                        android:textColor="@color/slate_muted" />

                    <TextView
                        android:id="@+id/txtDetailColor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Gris Metálico"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/slate_charcoal" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="•"
                        android:textColor="@color/slate_muted" />

                    <TextView
                        android:id="@+id/txtDetailYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Año 2023"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/slate_charcoal" />
                </LinearLayout>

                <!-- Price Highlight Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/emerald_container_light"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tarifa de Alquiler"
                                android:textColor="@color/emerald_on_container_light"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtDetailPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="$65.00"
                                android:textColor="@color/emerald_on_container_light"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_photo_counter"
                            android:text="Por cada 24 hrs"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Detailed Specifications Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Ficha Técnica"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/surface_light"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/outline_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Item: Marca -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Marca"
                                android:textColor="@color/slate_muted" />
                            <TextView
                                android:id="@+id/txtDetailSpecBrand"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Toyota"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="@color/surface_variant_light" />

                        <!-- Item: Modelo -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Modelo"
                                android:textColor="@color/slate_muted" />
                            <TextView
                                android:id="@+id/txtDetailSpecModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hilux 4x4"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="@color/surface_variant_light" />

                        <!-- Item: Año -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Año de fabricación"
                                android:textColor="@color/slate_muted" />
                            <TextView
                                android:id="@+id/txtDetailSpecYear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2023"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="@color/surface_variant_light" />

                        <!-- Item: Placa -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Número de placa"
                                android:textColor="@color/slate_muted" />
                            <TextView
                                android:id="@+id/txtDetailSpecPlate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="P 892-104"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="@color/surface_variant_light" />

                        <!-- Item: Color -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Color exterior"
                                android:textColor="@color/slate_muted" />
                            <TextView
                                android:id="@+id/txtDetailSpecColor"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Gris Metálico"
                                android:textColor="@color/obsidian_navy"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Description / Notes Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Descripción y Notas"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="@color/obsidian_navy"
                    android:textStyle="bold" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/surface_light"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/outline_light"
                    app:strokeWidth="1dp">

                    <TextView
                        android:id="@+id/txtDetailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:padding="16dp"
                        android:text="Sin notas registradas."
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/slate_charcoal" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Action Buttons: Edit & Delete -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailEdit"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/emerald_primary"
                        android:text="@string/vehicle_btn_edit"
                        android:textAllCaps="false"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_edit" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailDelete"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/vehicle_btn_delete"
                        android:textAllCaps="false"
                        android:textColor="@color/crimson_alert"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="@color/crimson_alert"
                        app:strokeColor="@color/crimson_alert" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
